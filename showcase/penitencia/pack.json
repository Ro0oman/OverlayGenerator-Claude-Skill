  "state": {
    "muertes": 0,
    "deuda": 0,
    "hechas": 0,
    "hechasDirecto": 0,
    "jefe": false,
    "empiezaEn": {
      "left": 300,
      "running": true,
      "at": 0
    },
    "porMuerte": 3,
    "ultimaMuerte": 0
  },
  "actions": {
    "muerte": {
      "label": "Me he muerto (+3)",
      "primary": true,
      "key": "F9",
      "cmd": "!muerte",
      "perm": "mods",
      "do": [
        {
          "op": "add",
          "key": "muertes",
          "value": 1
        },
        {
          "op": "add",
          "key": "deuda",
          "value": "$porMuerte"
        },
        {
          "op": "stamp",
          "key": "ultimaMuerte"
        },
        {
          "op": "event",
          "name": "muerte"
        }
      ]
    },
    "serie": {
      "label": "Serie hecha (−3)",
      "primary": true,
      "key": "F10",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "hechas",
          "value": "$porMuerte",
          "if": {
            "key": "deuda",
            "gt": 0
          }
        },
        {
          "op": "add",
          "key": "hechasDirecto",
          "value": "$porMuerte",
          "if": {
            "key": "deuda",
            "gt": 0
          }
        },
        {
          "op": "event",
          "name": "pago",
          "if": {
            "key": "deuda",
            "gt": 0
          }
        },
        {
          "op": "add",
          "key": "deuda",
          "value": "$porMuerte",
          "times": -1,
          "min": 0
        }
      ]
    },
    "mas15": {
      "label": "+15 flexiones (sin muerte)",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "deuda",
          "value": 15
        }
      ]
    },
    "deshacer": {
      "label": "Deshacer muerte",
      "key": "F12",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "muertes",
          "value": -1,
          "min": 0
        },
        {
          "op": "add",
          "key": "deuda",
          "value": "$porMuerte",
          "times": -1,
          "min": 0
        }
      ]
    },
    "deshacerSerie": {
      "label": "Deshacer serie",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "deuda",
          "value": "$porMuerte",
          "if": {
            "key": "hechas",
            "gt": 0
          }
        },
        {
          "op": "add",
          "key": "hechas",
          "value": "$porMuerte",
          "times": -1,
          "min": 0
        },
        {
          "op": "add",
          "key": "hechasDirecto",
          "value": "$porMuerte",
          "times": -1,
          "min": 0
        }
      ]
    },
    "jefe": {
      "label": "Jefe: alertas en espera",
      "key": "F11",
      "perm": "me",
      "do": [
        {
          "op": "toggle",
          "key": "jefe"
        }
      ]
    },
    "cuenta": {
      "label": "Reiniciar cuenta atrás",
      "perm": "me",
      "do": [
        {
          "op": "timer.set",
          "key": "empiezaEn",
          "value": 300
        },
        {
          "op": "timer.start",
          "key": "empiezaEn"
        }
      ]
    },
    "aJugar": {
      "label": "Ir a Juego",
      "perm": "me",
      "do": [
        {
          "op": "scene",
          "id": "juego"
        }
      ]
    },
    "aPausa": {
      "label": "Ir a Pausa",
      "perm": "me",
      "do": [
        {
          "op": "scene",
          "id": "pausa"
        }
      ]
    },
    "aFinal": {
      "label": "Ir a Final",
      "perm": "me",
      "do": [
        {
          "op": "scene",
          "id": "final"
        }
      ]
    },
    "cero": {
      "label": "Empezar de cero",
      "perm": "me",
      "do": [
        {
          "op": "reset",
          "key": "muertes"
        },
        {
          "op": "reset",
          "key": "deuda"
        },
        {
          "op": "reset",
          "key": "hechas"
        },
        {
          "op": "reset",
          "key": "jefe"
        },
        {
          "op": "reset",
          "key": "hechasDirecto"
        },
        {
          "op": "reset",
          "key": "ultimaMuerte"
        }
      ]
    },
    "nuevo": {
      "label": "Nuevo directo",
      "perm": "me",
      "do": [
        {
          "op": "reset",
          "key": "hechasDirecto"
        },
        {
          "op": "stamp",
          "key": "ultimaMuerte"
        }
      ]
    },
    "comandos": {
      "label": "Lista de comandos",
      "cmd": "!comandos",
      "perm": "all",
      "cooldown": 15,
      "do": [
        {
          "op": "event",
          "name": "comandos"
        }
      ]
    },
    "masCastigo": {
      "label": "+1 por muerte",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "porMuerte",
          "value": 1,
          "max": 20
        }
      ]
    },
    "menosCastigo": {
      "label": "−1 por muerte",
      "perm": "me",
      "do": [
        {
          "op": "add",
          "key": "porMuerte",
          "value": -1,
          "min": 1
        }
      ]
    },
    "respetos": {
      "label": "F (respetos)",
      "cmd": "!f",
      "perm": "all",
      "cooldown": 2,
      "do": [
        {
          "op": "event",
          "name": "respetos"
        }
      ]
    }
  },
  "panel": [
